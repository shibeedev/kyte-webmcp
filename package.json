{
  "name": "kyte-webmcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server delivered as a Chrome extension: native browser control, video understanding, full DevTools data and W3C WebMCP page tools.",
  "type": "module",
  "bin": {
    "kyte-webmcp": "dist/bridge/cli.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs --test && node --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.5",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.14.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
